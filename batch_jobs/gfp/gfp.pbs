#!/bin/bash
#PBS -N codon_gfp
#PBS -q normal
#PBS -l walltime=24:00:00
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -o /gpfs/home/sangiole/Github-repos/protein_design/LinearFoldMCOpt/batch_jobs/gfp/job.out
#PBS -e /gpfs/home/sangiole/Github-repos/protein_design/LinearFoldMCOpt/batch_jobs/gfp/job.err
#PBS -j oe

# Print job information
echo "Job started at $(date)"
echo "Running on host: $(hostname)"
echo "Working directory: $PBS_O_WORKDIR"
echo ""

# Change to submission directory
cd $PBS_O_WORKDIR

# Run codon optimization
echo "Starting codon optimization for gfp..."
/gpfs/home/sangiole/Github-repos/protein_design/bagel-recipes/.venv/bin/python /gpfs/home/sangiole/Github-repos/protein_design/LinearFoldMCOpt/codon_optimizer_cli.py optimize \
    --config /gpfs/home/sangiole/Github-repos/protein_design/LinearFoldMCOpt/batch_jobs/gfp/config.yaml \
    --job_name gfp

# Check exit status
if [ $? -eq 0 ]; then
    echo ""
    echo "Job gfp completed successfully at $(date)"
else
    echo ""
    echo "Job gfp FAILED at $(date)"
    exit 1
fi
